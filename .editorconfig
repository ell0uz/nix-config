# EditorConfig for ell's Nix Configuration
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.nix]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.json]
indent_size = 2
insert_final_newline = unset

[*.lock]
insert_final_newline = unset

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[.version]
insert_final_newline = false

[*.{diff,patch}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot,nib,torrent,asc,key,ovpn}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset